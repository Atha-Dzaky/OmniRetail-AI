# Local development environment variables
# Copy this file to .env and fill in the values before running the app.

# Database configuration
DATABASE_URL=postgresql://omniretail_user:YOUR_DB_PASSWORD@192.168.1.200:5432/omniretail

# LLM - Groq API
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE


# LangSmith LLMOps Configuration (Official Latest)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_KODE_API_KEY_KAMU_DISINI
LANGSMITH_PROJECT=OmniRetail-AI

# Optional: If you want to override the default DB host separately
# DB_HOST=192.168.1.200
# DB_PORT=5432
# DB_NAME=omniretail
# DB_USER=omniretail_user
# DB_PASSWORD=YOUR_DB_PASSWORD
